<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- groupId 使用 io.github.<GitHub用户名>，由 GitHub 自动验证域名所有权 -->
    <groupId>io.github.bestdata-chi</groupId>
    <artifactId>ts-oss-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>ts-oss</name>
    <description>
        时序数据库连接器：为主服务提供时序数据库（TDengine / Apache IoTDB）的连接、查询、写入、删除能力，
        统一屏蔽底层引擎差异。
    </description>
    <url>https://github.com/bestdata-chi/ts-oss</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>bestdata-chi</id>
            <name>ZhenyuChi</name>
            <email>chizhenyu1206@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/bestdata-chi/ts-oss.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/bestdata-chi/ts-oss.git</developerConnection>
        <url>https://github.com/bestdata-chi/ts-oss</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/bestdata-chi/ts-oss/issues</url>
    </issueManagement>

    <modules>
        <module>ts-oss-api</module>
        <module>ts-oss-core</module>
        <module>ts-oss-tdengine</module>
        <module>ts-oss-spring-boot-starter</module>
    </modules>

    <properties>
        <!-- 项目版本号：发版时只需改这一处（或用 -Drevision=X 命令行覆盖，无需改文件） -->
        <revision>1.0.3</revision>

        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.3.5</spring-boot.version>
        <taos-jdbcdriver.version>3.4.0</taos-jdbcdriver.version>
        <iotdb-session.version>1.3.2</iotdb-session.version>
        <hikaricp.version>5.1.0</hikaricp.version>

    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM，统一托管版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 本工程内部模块 -->
            <dependency>
                <groupId>io.github.bestdata-chi</groupId>
                <artifactId>ts-oss-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bestdata-chi</groupId>
                <artifactId>ts-oss-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bestdata-chi</groupId>
                <artifactId>ts-oss-tdengine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bestdata-chi</groupId>
                <artifactId>ts-oss-iotdb</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.bestdata-chi</groupId>
                <artifactId>ts-oss-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- TDengine JDBC 驱动 -->
            <dependency>
                <groupId>com.taosdata.jdbc</groupId>
                <artifactId>taos-jdbcdriver</artifactId>
                <version>${taos-jdbcdriver.version}</version>
            </dependency>

            <!-- Apache IoTDB 原生会话 -->
            <dependency>
                <groupId>org.apache.iotdb</groupId>
                <artifactId>iotdb-session</artifactId>
                <version>${iotdb-session.version}</version>
            </dependency>

            <!-- HikariCP 连接池 -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- 打包时附加 -sources.jar -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <!-- 打包时附加 -javadoc.jar -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.11.2</version>
                </plugin>
                <!-- GPG 签名（Central 强制要求） -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-gpg-plugin</artifactId>
                    <version>3.2.8</version>
                </plugin>
                <!-- 发布到 Maven Central（Sonatype Central Portal） -->
                <plugin>
                    <groupId>org.sonatype.central</groupId>
                    <artifactId>central-publishing-maven-plugin</artifactId>
                    <version>0.11.0</version>
                </plugin>
                <!-- 将 ${revision} 等 CI 友好占位符解析为真实版本号 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- 统一版本号：把 ${revision} 解析为真实版本，install/deploy 使用扁平化后的 POM -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 生成源码 jar，绑定到 package 阶段 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 生成 javadoc jar，绑定到 package 阶段 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <source>21</source>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
            </plugin>
            <!-- GPG 签名：verify 阶段对所有构件签名 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 发布到 Maven Central：接管 deploy 生命周期，直接上传到 Central Portal -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <!-- autoPublish=true：校验通过后自动发布；false（默认）：需在 Central Portal 手动点击 Publish。首次发布建议 false -->
                    <autoPublish>false</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
